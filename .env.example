# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=paddockai
POSTGRES_PASSWORD=paddockai_dev
POSTGRES_DB=paddockai

# Async URL (used by FastAPI / SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://paddockai:paddockai_dev@localhost:5432/paddockai

# Sync URL (used by seed scripts / Alembic)
DATABASE_URL_SYNC=postgresql://paddockai:paddockai_dev@localhost:5432/paddockai

# ── Backend ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-please
ALLOWED_ORIGINS=http://localhost:3000

# ── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to use seeded demo data without live API keys
DEMO_MODE=true

# ── OpenF1 API (optional — for live data) ────────────────────────────────────
OPENF1_BASE_URL=https://api.openf1.org/v1
# OPENF1_API_KEY=  (not required for public endpoints)

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
